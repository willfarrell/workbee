{
	"name": "workbee.js.org",
	"description": "SvelteKit SSR",
	"private": true,
	"version": "0.5.1",
	"type": "module",
	"scripts": {
		"start": "vite dev",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"build": "npm run build:svelte && npm run build:workers && npm run build:svg && npm run build:styles:extract && npm run build:styles:optimize",
		"build:svelte": "vite build",
		"build:workers": "cp -R .svelte-kit/output/server/_/immutable/workers .svelte-kit/cloudflare/_/immutable/workers",
		"build:styles:extract": "ds extract --input-dir ./.svelte-kit --theme ./src/styles/theme.css --output-dir src/styles/",
		"build:styles:optimize": "ds optimize-styles ./.svelte-kit",
		"build:svg": "npx svgo --multipass --recursive ./.svelte-kit/ -o ./.svelte-kit/",
		"release:login": "wrangler login --browser false",
		"release:domain": "curl https://api.cloudflare.com/client/v4/accounts/${ACCOUNT_ID}/pages/projects/workbee/domains -H 'Content-Type: application/json' -H 'Authorization: Bearer ${API_KEY_W_PAGES_EDIT}' -d '{\"name\": \"workbee.js.org\"}'",
		"release:deploy": "wrangler pages deploy"
	},
	"dependencies": {
		"@willfarrell-ds/svelte": "0.0.0-beta.1",
		"@willfarrell-ds/vanilla": "0.0.0-beta.1",
		"hast-util-to-string": "3.0.1",
		"mdast-util-to-string": "4.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@willfarrell-ds/cli": "0.0.0-beta.1",
		"mdsvex": "^0.12.0",
		"svelte": "^5.57.2",
		"svgo": "^4.1.0",
		"unist-util-visit": "^5.1.0",
		"vite": "^8.3.4",
		"vite-plugin-mkcert": "^2.0.0",
		"vite-plugin-sri": "^0.0.2",
		"wrangler": "^4.151.0"
	},
	"imports": {
		"#components/*": "./src/components/*",
		"#hooks/*": "./src/hooks/*",
		"#scripts/*": "./src/scripts/*",
		"#styles/*": "./src/styles/*"
	}
}
