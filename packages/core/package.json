{
	"name": "@work-bee/core",
	"version": "0.5.0",
	"description": "workbee service worker strategies",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"main": "./index.js",
	"module": "./index.js",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js",
			"default": "./index.js"
		}
	},
	"types": "./index.d.ts",
	"sideEffects": false,
	"files": [
		"index.js",
		"index.d.ts",
		"lib/*.js",
		"!lib/*.test.js",
		"!lib/*.bench.js",
		"!lib/*.fuzz.js"
	],
	"scripts": {
		"test": "node --test",
		"test:mutation": "cd ../.. && MUTATE_PACKAGE=\"$(basename \"$OLDPWD\")\" stryker run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/willfarrell/workbee.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/willfarrell/workbee/issues"
	},
	"homepage": "https://workbee.js.org/docs/packages/core",
	"keywords": [
		"workbee",
		"service",
		"worker",
		"sw",
		"strategies",
		"cache",
		"network"
	],
	"author": "willfarrell",
	"license": "MIT",
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/willfarrell"
	}
}
