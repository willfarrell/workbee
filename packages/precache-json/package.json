{
	"name": "@work-bee/precache-json",
	"version": "0.4.0",
	"description": "JSON precache manifest extractor for workbee service workers",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"main": "./index.js",
	"module": "./index.js",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js",
			"default": "./index.js"
		}
	},
	"types": "./index.d.ts",
	"sideEffects": false,
	"files": [
		"index.js",
		"index.d.ts"
	],
	"scripts": {
		"test": "node --test",
		"test:mutation": "cd ../.. && MUTATE_PACKAGE=\"$(basename \"$OLDPWD\")\" stryker run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/willfarrell/workbee.git",
		"directory": "packages/precache-json"
	},
	"bugs": {
		"url": "https://github.com/willfarrell/workbee/issues"
	},
	"homepage": "https://workbee.js.org/docs/packages/precache-json",
	"keywords": [
		"workbee",
		"service",
		"worker",
		"sw",
		"precache",
		"json",
		"manifest"
	],
	"engines": {
		"node": ">=24"
	},
	"author": "willfarrell",
	"license": "MIT",
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/willfarrell"
	}
}
